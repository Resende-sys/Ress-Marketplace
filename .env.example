# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Connect, ou Project Settings → API Keys).
# Estas duas são públicas. NUNCA coloque a secret/service_role key aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Segredos do Cloudflare R2 (só em .env.local / .dev.vars / painel da Cloudflare)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
